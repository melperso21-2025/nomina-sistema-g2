@{
    ViewData["Title"] = "New Salary";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">💰 New Salary</h2>
    <a asp-controller="Salaries" asp-action="Index" class="btn btn-outline-secondary">← Back</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body p-4">
        <form id="salaryForm" method="post" asp-controller="Salaries" asp-action="Crear">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> EMP_NO
                </label>
                <input type="number" name="emp_no" class="form-control"
                       required placeholder="e.g. 10001" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Salary
                </label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" name="salary" class="form-control"
                           required min="1" step="0.01" placeholder="1200.00" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> From date
                </label>
                <input type="date" name="from_date" class="form-control" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">To date <span class="text-muted small">(optional)</span></label>
                <input type="date" name="to_date" class="form-control" />
                <div class="form-text text-muted">Leave empty if salary is currently active.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Save</button>
                <a asp-controller="Salaries" asp-action="Index"
                   class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('salaryForm').addEventListener('submit', function (e) {
            var errors = [];
            var from = new Date(this.from_date.value);
            var toVal = this.to_date.value;

            if (!this.emp_no.value || this.emp_no.value <= 0) errors.push('EMP_NO must be greater than 0.');
            if (!this.salary.value || this.salary.value <= 0) errors.push('Salary must be greater than 0.');
            if (!this.from_date.value) errors.push('From date is required.');
            if (toVal && new Date(toVal) < from) errors.push('To date cannot be earlier than from date.');

            if (errors.length > 0) {
                alert(errors.join('\n'));
                e.preventDefault();
            }
        });
    </script>
}
