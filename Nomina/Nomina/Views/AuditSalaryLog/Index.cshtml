@model IEnumerable<Nomina.Models.LogAuditory>
@using System.Globalization

@{
    ViewData["Title"] = "Auditoría de Salarios";
    var usd = new CultureInfo("en-US");
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">📑 Auditoría de Salarios</h2>
            <div class="text-muted small">Registro de cambios salariales (solo lectura)</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:70px;">#</th>
                        <th style="width:80px;">N° Emp.</th>
                        <th class="text-center">Salario anterior</th>
                        <th class="text-center">Salario nuevo</th>
                        <th class="text-center" style="width:130px;">Desde</th>
                        <th style="width:160px;">Fecha</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-muted">@log.IdLog</td>
                            <td>@log.EmpNo</td>
                            <td class="text-muted text-end">
                                @(log.SalarioAnterior.HasValue ? log.SalarioAnterior.Value.ToString("C", usd) : "—")
                            </td>
                            <td class="fw-semibold text-success text-end">@log.SalarioNuevo.ToString("C", usd)</td>
                            <td class="text-center">
                                @if (log.FechaCambio == DateTime.MinValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <small class="text-muted">@log.FechaCambio.ToString("dd/MM/yyyy")</small>
                                }
                            </td>
                            <td>@log.ActionDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge bg-secondary">@(new string((log.UserResponsable ?? "").Where(ch => ch >= ' ' && ch != '\uFFFD').ToArray()).Trim())</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3">Registros: @(Model?.Count() ?? 0) (últimos 100)</div>
    </div>
</div>
