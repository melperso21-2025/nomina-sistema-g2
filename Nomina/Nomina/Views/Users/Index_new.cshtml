@model IEnumerable<Nomina.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">👤 System Users</h2>
        <div class="text-muted small">Access management (Admin only)</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th style="width:80px;">Emp #</th>
                        <th style="width:120px;">Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Username</td>
                            <td class="text-muted">@(u.EmpNo.HasValue ? u.EmpNo.Value.ToString() : "—")</td>
                            <td>
                                @if (u.Rol == "Admin")
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@u.Rol</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3">Users: @(Model?.Count() ?? 0)</div>
    </div>
</div>
