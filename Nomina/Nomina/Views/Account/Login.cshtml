@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Nómina G2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { min-height:100vh; background: linear-gradient(135deg,#1a1a2e 0%,#16213e 100%); }
        .login-card { border:0; border-radius:16px; }
        .brand-circle {
            width:72px; height:72px; border-radius:999px; background:#2563eb;
            display:inline-flex; align-items:center; justify-content:center;
            color:white; font-size:28px; margin-bottom:12px;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">
    <div class="card login-card shadow-lg" style="width:420px;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-3">
                <div class="brand-circle">💼</div>
                <div class="fw-bold fs-5" style="color:#1a1a2e;">NÓMINA G2</div>
                <div class="text-muted small">Payroll Management System</div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["Error"]</div>
            }

            <form id="loginForm" method="post" asp-controller="Account" asp-action="Login">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                    <input class="form-control" type="text" name="username"
                           maxlength="100" required autocomplete="username" />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                    <input class="form-control" type="password" name="password"
                           required autocomplete="current-password" />
                </div>
                <div class="d-grid">
                    <button class="btn btn-dark btn-lg" type="submit">Sign in</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            var user = this.username.value.trim();
            var pass = this.password.value.trim();
            if (!user || !pass) {
                alert('Username and password are required.');
                e.preventDefault();
            }
        });
    </script>
</body>
</html>
