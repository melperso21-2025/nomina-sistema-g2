@model IEnumerable<Nomina.Models.SalaryChangesReportItem>

@{
    ViewData["Title"] = "Salary Changes Report";
}

<style>
    @@media print {
        #sidebar, #topbar, .no-print { display: none !important; }
        #main { margin-left: 0 !important; }
        body { background: white; }
        .card { border: none !important; box-shadow: none !important; }
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3 no-print">
    <div>
        <h2 class="mb-0">📈 Salary Changes Report</h2>
        <div class="text-muted small">Historical salary change audit</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">← Back</a>
        <button class="btn btn-dark" onclick="window.print()">🖨 Print / Export PDF</button>
    </div>
</div>

<form class="row g-2 mb-3 no-print" method="get"
      asp-controller="Reports" asp-action="CambiosSalariales">
    <div class="col-auto">
        <input type="date" name="dateFrom" class="form-control"
               value="@ViewBag.DateFrom" placeholder="From" />
    </div>
    <div class="col-auto">
        <input type="date" name="dateTo" class="form-control"
               value="@ViewBag.DateTo" placeholder="To" />
    </div>
    <div class="col-auto">
        <input type="text" name="ci" class="form-control"
               value="@ViewBag.Ci" placeholder="ID (CI)" style="width:160px;" />
    </div>
    <div class="col-auto d-flex gap-2">
        <button class="btn btn-dark" type="submit">Filter</button>
        <a asp-controller="Reports" asp-action="CambiosSalariales"
           class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px;">#</th>
                        <th style="width:160px;">Date</th>
                        <th>Employee</th>
                        <th>ID (CI)</th>
                        <th>Previous salary</th>
                        <th>New salary</th>
                        <th style="width:130px;">Since</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.LogId</td>
                            <td>@item.ActionDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-semibold">@item.FullName</td>
                            <td>@item.Ci</td>
                            <td class="text-muted">@item.PreviousSalary.ToString("C")</td>
                            <td class="fw-semibold text-success">@item.NewSalary.ToString("C")</td>
                            <td>@item.FromDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-secondary">@item.UserSession</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3">Records: @(Model?.Count() ?? 0)</div>
    </div>
</div>
