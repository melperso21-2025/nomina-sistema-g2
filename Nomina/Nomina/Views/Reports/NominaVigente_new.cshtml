@model IEnumerable<Nomina.Models.PayrollReportItem>

@{
    ViewData["Title"] = "Active Payroll Report";
}

<style>
    @@media print {
        #sidebar, #topbar, .no-print { display: none !important; }
        #main { margin-left: 0 !important; }
        body { background: white; }
        .card { border: none !important; box-shadow: none !important; }
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3 no-print">
    <div>
        <h2 class="mb-0">📋 Active Payroll Report</h2>
        <div class="text-muted small">Current active salaries by department</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">← Back</a>
        <button class="btn btn-dark" onclick="window.print()">🖨 Print / Export PDF</button>
    </div>
</div>

<form class="d-flex gap-2 mb-3 no-print" method="get"
      asp-controller="Reports" asp-action="NominaVigente">
    <select name="deptNo" class="form-select" style="max-width:240px;">
        <option value="">— All departments —</option>
        @foreach (var d in (IEnumerable<Nomina.Models.DepartmentItem>)ViewBag.Departamentos)
        {
            <option value="@d.DeptNo"
                    @(ViewBag.DeptNoSeleccionado == d.DeptNo ? "selected" : "")>
                @d.DeptName
            </option>
        }
    </select>
    <button class="btn btn-dark" type="submit">Filter</button>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Department</th>
                        <th style="width:80px;">Emp #</th>
                        <th>Employee</th>
                        <th>ID (CI)</th>
                        <th>Title</th>
                        <th>Salary</th>
                        <th style="width:130px;">Since</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-primary">@item.DeptName</span></td>
                            <td class="text-muted">@item.EmpNo</td>
                            <td class="fw-semibold">@item.FullName</td>
                            <td>@item.Ci</td>
                            <td>@item.Title</td>
                            <td class="fw-semibold text-success">@item.Salary.ToString("C")</td>
                            <td>@item.SalarySince.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3 d-flex justify-content-between">
            <span>Employees: @(Model?.Count() ?? 0)</span>
            <span class="fw-semibold">Total payroll: @(Model?.Sum(x => x.Salary).ToString("C") ?? "$0")</span>
        </div>
    </div>
</div>
