@model IEnumerable<Nomina.Models.Department>

@{
    ViewData["Title"] = "Departamentos";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">🏢 Departamentos</h2>
        <div class="text-muted small">Total: @ViewBag.Total</div>
    </div>
    @if (Context.Session.GetString("rol") == "Admin")
    {
        <a class="btn btn-dark" asp-controller="Departments" asp-action="Crear">+ Nuevo departamento</a>
    }
</div>

@* Buscador *@
<form method="get" asp-controller="Departments" asp-action="Index" class="card shadow-sm mb-3">
    <div class="card-body d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label fw-semibold mb-1">Buscar por nombre</label>
            <input type="text" name="searchString" value="@ViewBag.SearchString"
                   class="form-control" style="min-width:260px;" placeholder="Ej: Tecnología" />
        </div>
        <button type="submit" class="btn btn-dark">🔍 Buscar</button>
        <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:100px;">Código</th>
                        <th>Nombre</th>
                        <th style="width:90px;">Estado</th>
                        <th class="text-end" style="width:160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@dept.DeptNo</td>
                            <td class="fw-semibold">@dept.DeptName</td>
                            <td>
                                @if (dept.IsActive)
                                { <span class="badge bg-success">Activo</span> }
                                else
                                { <span class="badge bg-danger">Inactivo</span> }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Departments" asp-action="Detalle"
                                   asp-route-id="@dept.DeptNo">Ver</a>
                                @if (Context.Session.GetString("rol") == "Admin")
                                {
                                    <a class="btn btn-sm btn-dark"
                                       asp-controller="Departments" asp-action="Editar"
                                       asp-route-id="@dept.DeptNo">Editar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <small class="text-muted">
                Mostrando @((ViewBag.Page - 1) * 20 + 1)–@(Math.Min((int)ViewBag.Page * 20, (int)ViewBag.Total)) de @ViewBag.Total departamentos
            </small>
            <div class="d-flex gap-2">
                @if (ViewBag.Page > 1)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Departments" asp-action="Index"
                       asp-route-page="@(ViewBag.Page - 1)"
                       asp-route-searchString="@ViewBag.SearchString">← Anterior</a>
                }
                @if ((int)ViewBag.Total > (int)ViewBag.Page * 20)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Departments" asp-action="Index"
                       asp-route-page="@(ViewBag.Page + 1)"
                       asp-route-searchString="@ViewBag.SearchString">Siguiente →</a>
                }
            </div>
        </div>
    </div>
</div>
