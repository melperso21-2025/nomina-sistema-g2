@model IEnumerable<Nomina.Models.SalaryListItem>
@using System.Globalization

@{
    ViewData["Title"] = "Salarios";
    var usd = new CultureInfo("en-US");
    string currentSortBy = ViewBag.SortBy as string ?? "empleado";
    string currentDirection = ViewBag.SortDirection as string ?? "asc";
    
    // Función helper para generar enlaces de ordenamiento
    string GetSortLink(string column)
    {
        var direction = "asc";
        var iconClass = "";
        
        if (currentSortBy == column)
        {
            direction = currentDirection == "asc" ? "desc" : "asc";
            iconClass = currentDirection == "asc" ? "fa-solid fa-sort-up" : "fa-solid fa-sort-down";
        }
        else
        {
            iconClass = "fa-solid fa-sort";
        }
        
        var url = Url.Action("Index", new { 
            sortBy = column, 
            sortDirection = direction
        });
        
        return $"{url}|{iconClass}";
    }
    
    var empleadoSort = GetSortLink("empleado").Split('|');
    var nombreSort = GetSortLink("nombre").Split('|');
    var salarioSort = GetSortLink("salario").Split('|');
    var fechaSort = GetSortLink("fecha").Split('|');
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">💰 Salarios</h2>
        <div class="text-muted small">Salarios activos vigentes</div>
    </div>
    @if (Context.Session.GetString("rol") == "Admin")
    {
        <a class="btn btn-dark" asp-controller="Salaries" asp-action="Crear">+ Nuevo salario</a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width:10%;">
                            <a href="@empleadoSort[0]" class="text-decoration-none text-white d-flex align-items-center justify-content-center">
                                N° Emp
                                <i class="@empleadoSort[1] ms-1"></i>
                            </a>
                        </th>
                        <th class="text-center" style="width:30%;">
                            <a href="@nombreSort[0]" class="text-decoration-none text-white d-flex align-items-center justify-content-center">
                                Empleado
                                <i class="@nombreSort[1] ms-1"></i>
                            </a>
                        </th>
                        <th class="text-center" style="width:15%;">
                            <a href="@salarioSort[0]" class="text-decoration-none text-white d-flex align-items-center justify-content-center">
                                Salario
                                <i class="@salarioSort[1] ms-1"></i>
                            </a>
                        </th>
                        <th class="text-center" style="width:15%;">
                            <a href="@fechaSort[0]" class="text-decoration-none text-white d-flex align-items-center justify-content-center">
                                Desde
                                <i class="@fechaSort[1] ms-1"></i>
                            </a>
                        </th>
                        <th class="text-center" style="width:10%;">Estado</th>
                        <th class="text-center" style="width:20%;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="text-start text-muted">@s.EmpNo</td>
                            <td class="text-start fw-semibold">@s.FullName</td>
                            <td class="fw-semibold text-success text-end">@s.Salary.ToString("C", usd)</td>
                            <td class="text-center"><small class="text-muted">@s.FromDate.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-center">
                                @if (s.ToDate == null)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    @s.ToDate.Value.ToString("dd/MM/yyyy")
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="Salaries" asp-action="Details"
                                       asp-route-id="@s.IdSalario">Ver</a>
                                    @if (Context.Session.GetString("rol") == "Admin")
                                    {
                                        <a class="btn btn-sm btn-dark"
                                           asp-controller="Salaries" asp-action="Edit"
                                           asp-route-id="@s.IdSalario">Editar</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3">Empleados activos: @(Model?.Count() ?? 0)</div>
    </div>
</div>
