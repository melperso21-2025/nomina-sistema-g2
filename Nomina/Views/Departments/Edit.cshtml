@{
    ViewData["Title"] = "Editar Departamento";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">🏢 Editar Departamento</h2>
    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body p-4">
        <form id="deptEditForm" method="post" asp-controller="Departments" asp-action="Edit">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Código (dept_no)</label>
                <input type="text" name="dept_no" class="form-control"
                       maxlength="4" value="d001" readonly />
                <div class="form-text text-muted">El código no puede modificarse.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Nombre del departamento
                </label>
                <input type="text" name="dept_name" class="form-control"
                       required maxlength="40" value="Tecnología" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Guardar cambios</button>
                <a asp-controller="Departments" asp-action="Index"
                   class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deptEditForm').addEventListener('submit', function (e) {
            if (!this.dept_name.value.trim()) {
                alert('El nombre del departamento es requerido.');
                e.preventDefault();
            }
        });
    </script>
}