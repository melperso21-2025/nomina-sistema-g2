@model IEnumerable<Nomina.Models.OrgChartItem>

@{
    ViewData["Title"] = "Estructura Organizacional";
}

<style>
    @@media print {
        #sidebar, #topbar, .no-print { display: none !important; }
        #main { margin-left: 0 !important; }
        body { background: white; }
        .card { border: none !important; box-shadow: none !important; }
        table { width: 100% !important; border-collapse: collapse !important; }
        tr { page-break-inside: avoid; }
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3 no-print">
    <div>
        <h2 class="mb-0">🏢 Estructura Organizacional</h2>
        <div class="text-muted small">Departamentos, gerentes activos y cantidad de empleados</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
        <button class="btn" style="background-color:#D32F2F; color:white;" onclick="window.print()">
            <i class="bi bi-file-pdf"></i> PDF / Imprimir
        </button>
        <a asp-controller="Reports" asp-action="ExportarEstructuraExcel"
           class="btn" style="background-color:#217346; color:white;">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Departamento</th>
                        <th>Gerente Activo</th>
                        <th class="text-center" style="width:160px;">Empleados Activos</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <span class="badge bg-primary">@item.DeptName</span>
                            </td>
                            <td>
                                @if (item.ManagerName == "Sin gerente")
                                {
                                    <span class="text-muted fst-italic">Sin gerente asignado</span>
                                }
                                else
                                {
                                    <span>👤 @item.ManagerName</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@item.EmployeeCount</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No hay departamentos activos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3 d-flex justify-content-between">
            <span>Total de departamentos: <strong>@Model.Count()</strong></span>
            <span>Total de empleados asignados: <strong>@Model.Sum(x => x.EmployeeCount)</strong></span>
        </div>
    </div>
</div>
