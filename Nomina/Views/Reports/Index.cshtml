@{
    ViewData["Title"] = "Informes";
}

<style>
    @@media print {
        .sidebar, .navbar, .btn { display: none; }
    }
</style>

<h2 class="mb-4">📊 Informes</h2>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">📋 Nómina vigente por departamento</h5>
                <p class="card-text text-muted small">Lista de salarios activos agrupada por departamento. Incluye exportación a PDF e impresión.</p>
                <a asp-controller="Reports" asp-action="NominaVigente"
                   class="btn btn-dark btn-sm">Generar</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">📈 Cambios salariales</h5>
                <p class="card-text text-muted small">Historial completo de cambios de salario con filtros por fecha y cédula. Incluye exportación a PDF e impresión.</p>
                <a asp-controller="Reports" asp-action="CambiosSalariales"
                   class="btn btn-dark btn-sm">Generar</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">🏢 Estructura Organizacional</h5>
                <p class="card-text text-muted small">Vista general de departamentos con su gerente activo y cantidad de empleados asignados. Incluye exportación a PDF e impresión.</p>
                <a asp-controller="Reports" asp-action="EstructuraOrganizacional"
                   class="btn btn-dark btn-sm">Generar</a>
            </div>
        </div>
    </div>
</div>
