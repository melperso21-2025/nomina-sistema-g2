@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">✏️ Editar Empleado</h2>
    <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="card shadow-sm" style="max-width:600px;">
    <div class="card-body p-4">
        <form id="empleadoEditForm" method="post" asp-controller="Employees" asp-action="Edit">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">CI</label>
                <input type="text" name="ci" class="form-control"
                       required maxlength="50" minlength="8" value="0102030405" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Nombre
                </label>
                <input type="text" name="first_name" class="form-control"
                       required maxlength="50" value="Ana" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Apellido
                </label>
                <input type="text" name="last_name" class="form-control"
                       required maxlength="50" value="Torres" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Correo
                </label>
                <input type="email" name="correo" class="form-control"
                       required maxlength="100" value="ana.torres@demo.com" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Departamento
                </label>
                <select name="departamento" class="form-select" required>
                    <option value="">Seleccione...</option>
                    <option value="Tecnología" selected>Tecnología</option>
                    <option value="Recursos Humanos">Recursos Humanos</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Fecha de ingreso
                </label>
                <input type="date" name="hire_date" class="form-control"
                       required value="2023-01-15" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">●</span> Género
                </label>
                <select name="gender" class="form-select" required>
                    <option value="">Seleccione...</option>
                    <option value="M">Masculino</option>
                    <option value="F" selected>Femenino</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Guardar cambios</button>
                <a asp-controller="Employees" asp-action="Index"
                   class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('empleadoEditForm').addEventListener('submit', function (e) {
            var correo = this.correo.value.trim();
            var ci = this.ci.value.trim();
            var errores = [];

            if (!/^[^@]+@[^@]+\.[a-zA-Z]{2,}$/.test(correo))
                errores.push('El correo no es válido.');

            if (ci.length < 8)
                errores.push('El CI debe tener al menos 8 caracteres.');

            if (errores.length > 0) {
                alert(errores.join('\n'));
                e.preventDefault();
            }
        });
    </script>
}
