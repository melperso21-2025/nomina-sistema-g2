@model Nomina.Models.EmployeeDetail
@using System.Globalization

@{
    ViewData["Title"] = "Detalle del Empleado";
    var usd = new CultureInfo("en-US");
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">👤 Detalle del Empleado</h2>
    <div>
        @if (Context.Session.GetString("rol") == "Admin")
        {
            <a asp-controller="Employees" asp-action="Editar" asp-route-id="@Model.EmpNo"
               class="btn btn-dark me-2">Editar</a>
        }
        <a asp-controller="Employees" asp-action="Index"
           class="btn btn-outline-secondary">← Volver</a>
    </div>
</div>

@* Datos personales *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Datos personales</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-2">
                <div class="text-muted small text-uppercase">N° Emp.</div>
                <div class="fw-bold">@Model.EmpNo</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small text-uppercase">Nombre completo</div>
                <div class="fw-bold">@Model.FullName</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small text-uppercase">Cédula</div>
                <div>@Model.Ci</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small text-uppercase">Género</div>
                <div>@Model.Gender</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small text-uppercase">Fecha de ingreso</div>
                <div>@Model.HireDate.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small text-uppercase">Correo electrónico</div>
                <div>@Model.Email</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small text-uppercase">Fecha de nacimiento</div>
                <div>@Model.BirthDate.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small text-uppercase">Estado</div>
                <div>
                    @if (Model.IsActive)
                    { <span class="badge bg-success">Activo</span> }
                    else
                    { <span class="badge bg-danger">Inactivo</span> }
                </div>
            </div>
        </div>
    </div>
</div>

@* Salario vigente + actualizar *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Salario vigente</div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="text-muted small text-uppercase">Salario</div>
                <div class="fw-bold text-success fs-5">@((Model.Salary).ToString("C", usd))</div>
            </div>
        </div>
        @if (Context.Session.GetString("rol") == "Admin")
        {
            <form method="post" asp-controller="Employees" asp-action="ActualizarSalario" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="empNo" value="@Model.EmpNo" />
                <div class="col-auto">
                    <label class="form-label fw-semibold">Nuevo salario</label>
                    <input type="number" name="salary" class="form-control" min="1" required placeholder="1400" />
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold">Desde</label>
                    <input type="date" name="fromDate" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">Actualizar salario</button>
                </div>
            </form>
        }
    </div>
</div>

@* Departamento + asignar *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Departamento</div>
    <div class="card-body">
        <div class="mb-3">
            <span class="fw-bold">@Model.DeptName</span>
        </div>
        @if (Context.Session.GetString("rol") == "Admin")
        {
            <form method="post" asp-controller="Employees" asp-action="AsignarDepartamento" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="empNo" value="@Model.EmpNo" />
                <div class="col-auto">
                    <label class="form-label fw-semibold">Departamento</label>
                    <select name="deptNo" class="form-select" required>
                        <option value="">Seleccionar...</option>
                        @foreach (var d in ViewBag.Departamentos as IEnumerable<Nomina.Models.DepartmentItem>)
                        {
                            <option value="@d.DeptNo">@d.DeptName</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold">Desde</label>
                    <input type="date" name="fromDate" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">Asignar</button>
                </div>
            </form>
        }
    </div>
</div>

@* Cargo + registrar *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Cargo / Puesto</div>
    <div class="card-body">
        <div class="mb-3">
            <span class="fw-bold">@Model.Title</span>
        </div>
        @if (Context.Session.GetString("rol") == "Admin")
        {
            <form method="post" asp-controller="Employees" asp-action="RegistrarTitulo" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="empNo" value="@Model.EmpNo" />
                <div class="col-auto">
                    <label class="form-label fw-semibold">Nuevo cargo</label>
                    <input type="text" name="title" class="form-control" required placeholder="Analista Senior" />
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold">Desde</label>
                    <input type="date" name="fromDate" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">Registrar</button>
                </div>
            </form>
        }
    </div>
</div>

@* Desactivar *@
@if (Model.IsActive && Context.Session.GetString("rol") == "Admin")
{
    <form method="post" asp-controller="Employees" asp-action="Desactivar" asp-route-id="@Model.EmpNo"
          onsubmit="return confirm('¿Está seguro de que desea desactivar a este empleado?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Desactivar empleado</button>
    </form>
}