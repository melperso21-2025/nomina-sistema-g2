@model IEnumerable<Nomina.Models.EmployeeListItem>

@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">👥 Empleados</h2>
        <div class="text-muted small">Total: @ViewBag.Total</div>
    </div>
    @if (Context.Session.GetString("rol") == "Admin")
    {
        <a class="btn btn-dark" asp-controller="Employees" asp-action="Crear">+ Nuevo empleado</a>
    }
</div>

<form method="get" asp-controller="Employees" asp-action="Index" class="card shadow-sm mb-3">
    <div class="card-body d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label fw-semibold mb-1">Buscar por nombre o CI</label>
            <input type="text" name="searchString" value="@ViewBag.SearchString"
                   class="form-control" style="min-width:260px;" placeholder="Ej: García o 0102030405" />
        </div>
        <button type="submit" class="btn btn-dark">🔍 Buscar</button>
        <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:80px;">N° Emp.</th>
                        <th style="width:120px;">Cédula</th>
                        <th>Nombre completo</th>
                        <th>Departamento</th>
                        <th style="width:80px;">Género</th>
                        <th style="width:120px;">Fecha ingreso</th>
                        <th class="text-end" style="width:160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.EmpNo</td>
                            <td>@emp.Ci</td>
                            <td>@emp.FullName</td>
                            <td>@emp.DeptName</td>
                            <td>@emp.Gender</td>
                            <td>@emp.HireDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Employees" asp-action="Detalle"
                                   asp-route-id="@emp.EmpNo">Ver</a>
                                @if (Context.Session.GetString("rol") == "Admin")
                                {
                                    <a class="btn btn-sm btn-dark"
                                       asp-controller="Employees" asp-action="Editar"
                                       asp-route-id="@emp.EmpNo">Editar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <small class="text-muted">
                Mostrando @((ViewBag.Page - 1) * 20 + 1)–@(Math.Min((int)ViewBag.Page * 20, (int)ViewBag.Total)) de @ViewBag.Total empleados
            </small>
            <div class="d-flex gap-2">
                @if (ViewBag.Page > 1)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Employees" asp-action="Index"
                       asp-route-page="@(ViewBag.Page - 1)"
                       asp-route-searchString="@ViewBag.SearchString">← Anterior</a>
                }
                @if ((int)ViewBag.Total > (int)ViewBag.Page * 20)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Employees" asp-action="Index"
                       asp-route-page="@(ViewBag.Page + 1)"
                       asp-route-searchString="@ViewBag.SearchString">Siguiente →</a>
                }
            </div>
        </div>
    </div>
</div>
