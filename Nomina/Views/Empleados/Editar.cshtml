
@model Nomina.Models.EditEmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">?? Edit Employee</h2>
    <a asp-controller="Empleados" asp-action="Detalle" asp-route-id="@Model.EmpNo"
       class="btn btn-outline-secondary">? Back</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">?? @ViewBag.Error</div>
}

<div class="card shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form id="empleadoEditForm" method="post" asp-controller="Empleados" asp-action="Editar">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmpNo" value="@Model.EmpNo" />

            <div class="mb-3">
                <label class="form-label fw-semibold"><span class="text-danger">?</span> First name</label>
                <input type="text" name="FirstName" value="@Model.FirstName"
                       class="form-control" required maxlength="50" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold"><span class="text-danger">?</span> Last name</label>
                <input type="text" name="LastName" value="@Model.LastName"
                       class="form-control" required maxlength="50" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold"><span class="text-danger">?</span> Birth date</label>
                <input type="date" name="BirthDate" value="@Model.BirthDate.ToString("yyyy-MM-dd")"
                       class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold"><span class="text-danger">?</span> Gender</label>
                <select name="Gender" class="form-select" required>
                    <option value="">Select...</option>
                    @if (Model.Gender == "M")
                    {
                        <option value="M" selected>Male</option>
                        <option value="F">Female</option>
                    }
                    else
                    {
                        <option value="M">Male</option>
                        <option value="F" selected>Female</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold"><span class="text-danger">?</span> Email</label>
                <input type="email" name="Email" value="@Model.Email"
                       class="form-control" required maxlength="100" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Save changes</button>
                <a asp-controller="Empleados" asp-action="Detalle" asp-route-id="@Model.EmpNo"
                   class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script>
        (function() {
            var form = document.getElementById('empleadoEditForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var email = document.getElementsByName('Email')[0].value.trim();
                    var errores = [];
                    var atSymbol = String.fromCharCode(64);
                    var dotSymbol = '.';

                    if (email.indexOf(atSymbol) === -1 || email.indexOf(dotSymbol) === -1 || email.length < 5) {
                        errores.push('Email is not valid.');
                    }

                    if (errores.length > 0) {
                        alert(errores.join('\n'));
                        e.preventDefault();
                    }
                });
            }
        })();
    </script>
}
