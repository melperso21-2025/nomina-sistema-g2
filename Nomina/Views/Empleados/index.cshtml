@model IEnumerable<Nomina.Models.EmployeeListItem>

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">?? Employees</h2>
        <div class="text-muted small">Total: @ViewBag.Total</div>
    </div>
    <a class="btn btn-dark" asp-controller="Empleados" asp-action="Crear">+ New employee</a>
</div>

@* Filtros *@
<form method="get" asp-controller="Empleados" asp-action="Index" class="card shadow-sm mb-3">
    <div class="card-body d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label fw-semibold mb-1">Name / CI</label>
            <input type="text" name="filterName" value="@ViewBag.FilterName"
                   class="form-control" style="min-width:200px;" placeholder="Search..." />
        </div>
        <div>
            <label class="form-label fw-semibold mb-1">CI exact</label>
            <input type="text" name="filterCi" value="@ViewBag.FilterCi"
                   class="form-control" style="min-width:150px;" placeholder="0102030405" />
        </div>
        <button type="submit" class="btn btn-dark">Filter</button>
        <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">Emp #</th>
                        <th style="width:120px;">CI</th>
                        <th>Full name</th>
                        <th>Department</th>
                        <th style="width:80px;">Gender</th>
                        <th style="width:120px;">Hire date</th>
                        <th class="text-end" style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.EmpNo</td>
                            <td>@emp.Ci</td>
                            <td>@emp.FullName</td>
                            <td>@emp.DeptName</td>
                            <td>@emp.Gender</td>
                            <td>@emp.HireDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Empleados" asp-action="Detalle"
                                   asp-route-id="@emp.EmpNo">View</a>
                                <a class="btn btn-sm btn-dark"
                                   asp-controller="Empleados" asp-action="Editar"
                                   asp-route-id="@emp.EmpNo">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @* Paginación *@
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <small class="text-muted">
                Showing @((ViewBag.Page - 1) * 20 + 1)–@(Math.Min((int)ViewBag.Page * 20, (int)ViewBag.Total)) of @ViewBag.Total employees
            </small>
            <div class="d-flex gap-2">
                @if (ViewBag.Page > 1)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Empleados" asp-action="Index"
                       asp-route-page="@(ViewBag.Page - 1)"
                       asp-route-filterName="@ViewBag.FilterName"
                       asp-route-filterCi="@ViewBag.FilterCi">? Prev</a>
                }
                @if ((int)ViewBag.Total > (int)ViewBag.Page * 20)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Empleados" asp-action="Index"
                       asp-route-page="@(ViewBag.Page + 1)"
                       asp-route-filterName="@ViewBag.FilterName"
                       asp-route-filterCi="@ViewBag.FilterCi">Next ?</a>
                }
            </div>
        </div>
    </div>
</div>