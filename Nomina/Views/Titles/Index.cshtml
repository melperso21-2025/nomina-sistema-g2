@{
    ViewData["Title"] = "Titles";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">Titles</h2>
        <div class="text-muted small">Demo data</div>
    </div>
    <a class="btn btn-primary" href="#">Assign title</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Emp #</th>
                        <th>Title</th>
                        <th style="width: 140px;">From</th>
                        <th style="width: 140px;">To</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>10001</td>
                        <td>Senior Analyst</td>
                        <td>2023-01-15</td>
                        <td>9999-12-31</td>
                    </tr>
                    <tr>
                        <td>10002</td>
                        <td>HR Coordinator</td>
                        <td>2022-09-01</td>
                        <td>9999-12-31</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-3">Demo data only.</div>
    </div>
</div>