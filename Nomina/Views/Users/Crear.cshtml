@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">➕ Nuevo Usuario</h2>
    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body p-4">
        <form method="post" asp-controller="Users" asp-action="Crear">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Empleado
                </label>
                <select name="empNo" class="form-select" required>
                    <option value="">— Seleccionar empleado —</option>
                    @foreach (dynamic emp in ViewBag.Empleados)
                    {
                        <option value="@emp.EmpNo">[@emp.EmpNo] @emp.FullName</option>
                    }
                </select>
                <div class="form-text text-muted">Solo empleados sin cuenta de acceso.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Nombre de Usuario
                </label>
                <input type="text" name="username" class="form-control"
                       required maxlength="100" placeholder="ej. juan.perez" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Contraseña
                </label>
                <input type="password" name="password" class="form-control"
                       required minlength="6" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Rol
                </label>
                <select name="rol" class="form-select" required>
                    <option value="RRHH">RRHH</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Guardar
                </button>
                <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary px-4">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
