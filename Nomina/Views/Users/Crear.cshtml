@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">➕ Nuevo Usuario</h2>
    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body p-4">
        <form method="post" asp-controller="Users" asp-action="Crear">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Empleado
                </label>
                <select name="empNo" id="empSelect" class="form-select" required>
                    <option value="">— Seleccionar empleado —</option>
                    @foreach (dynamic emp in ViewBag.Empleados)
                    {
                        <option value="@emp.EmpNo" data-fullname="@emp.FullName">[@emp.EmpNo] @emp.FullName</option>
                    }
                </select>
                <div class="form-text text-muted">Solo empleados sin cuenta de acceso.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Nombre de Usuario
                </label>
                <input type="text" name="username" id="usernameInput" class="form-control"
                       required maxlength="100" placeholder="Se genera automáticamente" />
                <div class="form-text text-muted">Formato: nombre.apellido (se genera automáticamente al seleccionar empleado)</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Contraseña
                </label>
                <input type="password" name="password" class="form-control"
                       required minlength="6" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Rol
                </label>
                <select name="rol" class="form-select" required>
                    <option value="RRHH">RRHH</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Guardar
                </button>
                <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary px-4">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<script>
document.getElementById('empSelect').addEventListener('change', function() {
    const selectedOption = this.options[this.selectedIndex];
    const fullName = selectedOption.getAttribute('data-fullname');

    if (fullName) {
        // Convertir "Juan Perez" a "juan.perez"
        const username = fullName
            .toLowerCase()
            .trim()
            .split(/\s+/)  // dividir por espacios
            .filter(word => word.length > 0)  // eliminar espacios vacíos
            .slice(0, 2)   // tomar solo primeros 2 palabras (nombre y apellido)
            .join('.');    // unir con punto

        document.getElementById('usernameInput').value = username;
        document.getElementById('usernameInput').setAttribute('data-suggested', username);
    }
});

// Validar que el username solo contenga caracteres permitidos
document.getElementById('usernameInput').addEventListener('blur', function() {
    const regex = /^[a-z0-9.]+$/;
    if (this.value && !regex.test(this.value)) {
        alert('El nombre de usuario solo puede contener letras minúsculas, números y puntos.');
        this.value = this.getAttribute('data-suggested') || '';
    }
});
</script>
