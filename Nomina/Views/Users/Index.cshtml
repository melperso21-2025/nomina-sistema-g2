@model IEnumerable<Nomina.Models.User>

@{
    ViewData["Title"] = "Usuarios del Sistema";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-0">👤 Usuarios del Sistema</h2>
        <div class="text-muted small">Gestión de Accesos (Solo Admin)</div>
    </div>
    <a asp-controller="Users" asp-action="Crear" class="btn btn-dark">
        <i class="fa-solid fa-plus me-1"></i> Nuevo Usuario
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Usuario</th>
                        <th style="width:110px;">ID Empleado</th>
                        <th style="width:110px;">Rol</th>
                        <th style="width:160px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Username</td>
                            <td class="text-muted">@(u.EmpNo.HasValue ? u.EmpNo.Value.ToString() : "—")</td>
                            <td>
                                @if (u.Rol == "Admin")
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@u.Rol</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-controller="Users" asp-action="Editar"
                                       asp-route-empNo="@u.EmpNo"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-pen-to-square"></i> Editar
                                    </a>
                                    <form method="post" asp-controller="Users" asp-action="Eliminar"
                                          onsubmit="return confirm('¿Eliminar al usuario @u.Username?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="empNo" value="@u.EmpNo" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fa-solid fa-circle-info me-2"></i>No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3">
            <i class="fa-solid fa-users me-1"></i> Total: @(Model?.Count() ?? 0) usuarios
        </div>
    </div>
</div>
