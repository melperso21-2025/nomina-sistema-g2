@{
    ViewData["Title"] = "Users";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">👥 System Users</h2>
        <div class="text-muted small">Access management</div>
    </div>
    <a class="btn btn-dark" href="#">+ New user</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Full name</th>
                        <th>Role</th>
                        <th class="text-end" style="width:180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>admin</td>
                        <td>Administrator</td>
                        <td><span class="badge bg-primary">Admin</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="#">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" href="#">Delete</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="text-muted small p-3">Test data only.</div>
    </div>
</div>