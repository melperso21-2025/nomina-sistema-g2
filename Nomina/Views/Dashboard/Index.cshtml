@model Nomina.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white mb-3" style="background: linear-gradient(135deg, #2563eb 0%, #1a1a2e 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">EMPLOYEES</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalEmpleados</h2>
                    </div>
                    <div><span class="fs-2">👤</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white mb-3" style="background: linear-gradient(135deg, #059669 0%, #2563eb 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">DEPARTMENTS</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalDepartamentos</h2>
                    </div>
                    <div><span class="fs-2">🏢</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white mb-3" style="background: linear-gradient(135deg, #4f7cff 0%, #059669 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">AVG SALARY</h6>
                        <h2 class="mb-0 fw-bold">@Model.SalarioPromedio.ToString("C")</h2>
                    </div>
                    <div><span class="fs-2">💰</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-semibold">Latest salary changes</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Previous</th>
                        <th>New salary</th>
                        <th style="width:160px;">Date</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.UltimosCambios)
                    {
                        <tr>
                            <td>@c.FullName</td>
                            <td class="text-muted">@c.PreviousSalary.ToString("C")</td>
                            <td class="text-success fw-semibold">@c.NewSalary.ToString("C")</td>
                            <td><small class="text-muted">@c.ActionDate.ToString("yyyy-MM-dd")</small></td>
                            <td><small>@c.UserSession</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>  