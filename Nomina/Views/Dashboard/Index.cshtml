@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white mb-3" style="background: linear-gradient(135deg, #2563eb 0%, #1a1a2e 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">EMPLOYEES</h6>
                        <h2 class="mb-0 fw-bold">142</h2>
                    </div>
                    <div><span class="fs-2">👤</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white mb-3" style="background: linear-gradient(135deg, #059669 0%, #2563eb 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">DEPARTMENTS</h6>
                        <h2 class="mb-0 fw-bold">8</h2>
                    </div>
                    <div><span class="fs-2">🏢</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white mb-3" style="background: linear-gradient(135deg, #4f7cff 0%, #059669 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">AVG SALARY</h6>
                        <h2 class="mb-0 fw-bold">$1,240</h2>
                    </div>
                    <div><span class="fs-2">💰</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-semibold">Latest salary changes</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Change</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Ana Torres</td>
                        <td><span class="text-success fw-semibold">+$200 → $1,400</span></td>
                        <td><small class="text-muted">today</small></td>
                    </tr>
                    <tr>
                        <td>Carlos Ruiz</td>
                        <td><span class="text-success fw-semibold">+$150 → $1,150</span></td>
                        <td><small class="text-muted">yesterday</small></td>
                    </tr>
                    <tr>
                        <td>María León</td>
                        <td><span class="text-success fw-semibold">+$300 → $2,100</span></td>
                        <td><small class="text-muted">2 days ago</small></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>